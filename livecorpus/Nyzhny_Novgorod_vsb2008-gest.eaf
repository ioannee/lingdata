    <TIER ANNOTATOR="ioannee" LINGUISTIC_TYPE_REF="gesture_comment"
        PARENT_REF="gestType@vsb2008f" PARTICIPANT="@vsb2008f" TIER_ID="gestComment@vsb2008f">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a386" ANNOTATION_REF="a384">
                <ANNOTATION_VALUE>наложились два жеста и потом следующий начался</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a394" ANNOTATION_REF="a389">
                <ANNOTATION_VALUE>"если" условное обозначение рукой?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a432" ANNOTATION_REF="a387">
                <ANNOTATION_VALUE>просто "действие" или "направление" не очень подходит вроде</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a430" ANNOTATION_REF="a405">
                <ANNOTATION_VALUE>или просто "задумалась"</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a435" ANNOTATION_REF="a410">
                <ANNOTATION_VALUE>длина не очень понятна</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a431" ANNOTATION_REF="a419">
                <ANNOTATION_VALUE>дискомфорт? просто "неприятно" или "усталось" не очень</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
